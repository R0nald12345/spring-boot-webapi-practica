      <mxGeometry x="50" y="500" width="1770" height="660" as="geometry" />
    </mxCell>

    <!-- Paso 7: Descargar JAR -->
    <mxCell id="wsl1" value="7. Descargar JAR de la Release&#xa;curl GitHub Release&#xa;→ ~/blue-green/releases/webapi-1.1.0.jar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;strokeColor=#0f3460;fontSize=10;fontColor=#ffffff;" vertex="1" parent="zone5">
      <mxGeometry x="40" y="60" width="220" height="80" as="geometry" />
    </mxCell>

    <!-- Paso 8: Deploy BLUE -->
    <mxCell id="wsl2" value="8. deploy-blue-green.sh&#xa;webapi-1.1.0.jar blue&#xa;─────────────────&#xa;Inicia app en :8081&#xa;--app.instance.name=BLUE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b3d91;strokeColor=#1a73e8;fontSize=10;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="zone5">
      <mxGeometry x="320" y="55" width="220" height="90" as="geometry" />
    </mxCell>

    <!-- Paso 9: Health Check BLUE -->
    <mxCell id="wsl3" value="9. health-check.sh&#xa;✅ BLUE :8081 HEALTHY" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="zone5">
      <mxGeometry x="330" y="195" width="200" height="75" as="geometry" />
    </mxCell>

    <!-- NGINX Config -->
    <mxCell id="nginx" value="🔀 NGINX — Puerto :8085&#xa;─────────────────&#xa;upstream → BLUE :8081&#xa;(proxy_pass http://blue_green)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#006600;strokeColor=#004d00;fontSize=10;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="zone5">
      <mxGeometry x="640" y="190" width="240" height="85" as="geometry" />
    </mxCell>

    <!-- Paso 10: Traffic Test 1 -->
    <mxCell id="wsl4" value="10. traffic-test.sh 10&#xa;BLUE 100% | GREEN 0%&#xa;✅ Todo va a BLUE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b3d91;strokeColor=#1a73e8;fontSize=10;fontColor=#ffffff;" vertex="1" parent="zone5">
      <mxGeometry x="645" y="60" width="230" height="80" as="geometry" />
    </mxCell>

    <!-- Paso 11: Deploy GREEN -->
    <mxCell id="wsl5" value="11. deploy-blue-green.sh&#xa;webapi-1.1.0.jar green&#xa;─────────────────&#xa;Inicia app en :8082&#xa;--app.instance.name=GREEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a5c00;strokeColor=#4d9900;fontSize=10;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="zone5">
      <mxGeometry x="970" y="55" width="220" height="90" as="geometry" />
    </mxCell>

    <!-- Paso 12: Health Check GREEN -->
    <mxCell id="wsl6" value="12. health-check.sh&#xa;✅ GREEN :8082 HEALTHY" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="zone5">
      <mxGeometry x="980" y="195" width="200" height="75" as="geometry" />
    </mxCell>

    <!-- Paso 13: Switch Traffic -->
    <mxCell id="wsl7" value="13. switch-traffic.sh green&#xa;─────────────────&#xa;Nginx: BLUE :8081&#xa;        ↓&#xa;       GREEN :8082&#xa;⚡ ZERO DOWNTIME" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a5c00;strokeColor=#4d9900;fontSize=10;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="zone5">
      <mxGeometry x="970" y="325" width="220" height="100" as="geometry" />
    </mxCell>

    <!-- Paso 14: Traffic Test 2 -->
    <mxCell id="wsl8" value="14. traffic-test.sh 10&#xa;BLUE 0% | GREEN 100%&#xa;✅ Todo va a GREEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a5c00;strokeColor=#4d9900;fontSize=10;fontColor=#ffffff;" vertex="1" parent="zone5">
      <mxGeometry x="1290" y="335" width="220" height="80" as="geometry" />
    </mxCell>

    <!-- Paso 15: Simular falla GREEN -->
    <mxCell id="wsl9" value="15. Simular falla GREEN&#xa;kill $(lsof -ti tcp:8082)&#xa;❌ GREEN DOWN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#6d0001;fontSize=10;fontColor=#ffffff;" vertex="1" parent="zone5">
      <mxGeometry x="1290" y="470" width="220" height="80" as="geometry" />
    </mxCell>

    <!-- Paso 16: Rollback -->
    <mxCell id="wsl10" value="16. rollback.sh blue&#xa;─────────────────&#xa;switch-traffic.sh blue&#xa;Nginx vuelve a BLUE :8081&#xa;⏪ ROLLBACK EXITOSO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6d0001;strokeColor=#b85450;fontSize=10;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="zone5">
      <mxGeometry x="970" y="465" width="220" height="90" as="geometry" />
    </mxCell>

    <!-- Paso 17: Verificar rollback -->
    <mxCell id="wsl11" value="17. traffic-test.sh 10&#xa;BLUE 100% | GREEN 0%&#xa;✅ Sistema estable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b3d91;strokeColor=#1a73e8;fontSize=10;fontColor=#ffffff;" vertex="1" parent="zone5">
      <mxGeometry x="645" y="470" width="230" height="80" as="geometry" />
